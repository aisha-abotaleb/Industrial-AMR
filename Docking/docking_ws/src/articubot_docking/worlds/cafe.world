<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- AprilTag dock: same pose as before (3,0), facing the robot spawn (-x) -->
    <include>
      <name>apriltag_dock</name>
      <uri>model://apriltag_dock</uri>
      <pose>3.0 0 0 0 0 0</pose>
    </include>

    <model name="wall_n"><static>true</static><pose>0 3.0 1.0 0 0 0</pose><link name="l">
      <collision name="c"><geometry><box><size>7.0 0.1 2.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>7.0 0.1 2.0</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
    </link></model>
